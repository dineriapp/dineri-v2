{
  "name": "dineri-rewamp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:build": "pnpm db:push && pnpm build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "tsx ./src/drizzle/baseline.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx ./src/drizzle/seed/seed.ts",
    "db:seed:reservations": "tsx ./src/drizzle/seed/seed-reservations.ts",
    "db:seed:analytics": "node --conditions=react-server --import tsx ./src/drizzle/seed/seed-analytics.ts",
    "db:backfill:activity": "tsx ./src/drizzle/seed/backfill-activity.ts",
    "type-check": "tsc --noEmit",
    "audit:ci": "pnpm audit --audit-level=high",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./src/lib/auth/server.ts --output ./src/drizzle/schemas/better-auth-generated-schema.ts --yes",
    "google:check": "tsx ./src/lib/google/check-places.ts",
    "holds:reconcile": "tsx --conditions=react-server ./src/scripts/reconcile-stale-holds.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@better-auth/stripe": "^1.6.27",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@vercel/functions": "^3.9.1",
    "better-auth": "1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cryptr": "^6.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "immer": "^11.1.16",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-country-flag": "^3.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "stripe": "22.0.0",
    "tailwind-animate": "^0.2.10",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": "prettier --write"
  }
}
